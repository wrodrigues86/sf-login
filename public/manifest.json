{
  "manifest_version": 3,
  "name": "Salesforce Auto Login",
  "version": "1.1",
  "permissions": ["tabs", "scripting", "storage"], 
  "host_permissions": [
    "https://test.salesforce.com/*",
    "https://login.salesforce.com/*",
    "https://*.lightning.force.com/*",
    "https://*.sandbox.my.salesforce.com/*"
  ],
  "action": {
    "default_popup": "index.html"
  }
}
